{
  "comment": "インライン名前変更、入力エラー、空フォルダーと新規フォルダーの名前変更を撮影する。",
  "steps": [
    {"action": "size", "width": 1280, "height": 800},
    {"action": "view", "mode": "rows"},
    {"action": "select", "name": "notes.txt"},
    {"action": "key", "keys": "f2"},
    {"action": "theme", "theme": "light"},
    {"action": "screenshot", "name": "rename-editor-active-light"},
    {"action": "theme", "theme": "dark"},
    {"action": "screenshot", "name": "rename-editor-active-dark"},
    {"action": "key", "keys": "ctrl-a backspace tab"},
    {"action": "theme", "theme": "light"},
    {"action": "screenshot", "name": "rename-invalid-name-light"},
    {"action": "theme", "theme": "dark"},
    {"action": "screenshot", "name": "rename-invalid-name-dark"},
    {"action": "key", "keys": "escape"},
    {"action": "navigate", "path": "empty"},
    {"action": "wait_idle"},
    {"action": "theme", "theme": "light"},
    {"action": "screenshot", "name": "empty-folder-light"},
    {"action": "theme", "theme": "dark"},
    {"action": "screenshot", "name": "empty-folder-dark"},
    {"action": "view", "mode": "icons"},
    {"action": "key", "keys": "ctrl-shift-n"},
    {"action": "wait_idle", "entry": "New Folder"},
    {"action": "select", "name": "New Folder"},
    {"action": "theme", "theme": "light"},
    {"action": "screenshot", "name": "new-folder-created-light"},
    {"action": "theme", "theme": "dark"},
    {"action": "screenshot", "name": "new-folder-created-dark"},
    {"action": "key", "keys": "f2"},
    {"action": "theme", "theme": "light"},
    {"action": "screenshot", "name": "new-folder-rename-editor-light"},
    {"action": "theme", "theme": "dark"},
    {"action": "screenshot", "name": "new-folder-rename-editor-dark"}
  ]
}
